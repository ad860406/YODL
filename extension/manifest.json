{
  "manifest_version": 3,
  "name": "YODL - Descargar video/audio",
  "version": "1.0.0",
  "description": "Detecta videos en la pagina actual y los descarga con tu sesion iniciada (resuelve Stories, Reels, etc.).",
  "permissions": ["downloads", "activeTab", "scripting", "webRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8790/*", "http://localhost:8790/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YODL"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
